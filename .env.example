# ─────────────────────────────────────────────────────────────
# 지금은 빌드 과정이 없어서 이 파일을 읽는 코드가 없습니다.
# 아래 값이 필요해지는 시점을 미리 적어 둡니다.
#
# 주의: 정적 사이트에 넣는 값은 소스 보기로 전부 드러납니다.
#       비밀키는 절대 여기에 두지 마세요. 서버가 생긴 뒤에 서버에 둡니다.
# ─────────────────────────────────────────────────────────────

# 견적 문의 폼을 실제로 보내려면 받아 줄 엔드포인트가 필요합니다.
# (자체 서버 · Formspree · Web3Forms 등)
# index.html 의 sendInquiry() 에서 이 주소로 보내도록 바꿉니다.
FORM_ENDPOINT=

# 방문 통계를 붙일 때. 공개돼도 되는 식별자만 넣으세요.
ANALYTICS_ID=

# 배포 도메인. sitemap.xml 과 og:url 에 쓰는 주소와 맞춰야 합니다.
SITE_URL=https://taeyang4.github.io/project-forge
