# ──────────────────────────────────────────────────────────────
# 배포되면 안 되는 것
#
# Vercel·Netlify·GitHub Pages 같은 정적 호스팅은 저장소를 그대로
# 올리므로, 여기에 적힌 파일은 커밋되지 않고 따라서 배포도 되지 않는다.
#
# 다만 버전 관리에서도 빠지니 admin.html 은 따로 백업해 두는 게 좋다.
# (배포 설정에서 제외하는 방법도 있지만 호스팅마다 달라 실수하기 쉽다.
#  저장소에 아예 넣지 않는 쪽이 확실하다.)
#
# 주의: Git 은 줄 끝 주석을 지원하지 않는다. 패턴 뒤에 설명을 붙이면
#       그 전체가 패턴이 되어 아무것도 걸러내지 못한다.
# ──────────────────────────────────────────────────────────────

# 콘텐츠 편집기 — 인증이 없다. 공개되면 누구나 연다
site/admin.html

# 편집 결과를 forge.html 에 넣는 스크립트
site/apply.py

# 편집기가 내보낸 임시 파일
site/site-data.json

# apply.py 가 남기는 백업
site/*.bak
*.bak

# ── 환경 변수 ──
# .env.example 만 저장소에 둔다. 실제 값이 든 .env 는 절대 올리지 않는다.
.env
.env.*
!.env.example

# ── 파이썬 ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── 편집기 ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── bake.py 가 받아 두는 폰트 원본 ──
# 2MB 라 저장소에 넣지 않는다. 없으면 bake.py 가 알아서 다시 받는다.
PretendardVariable.woff2
.subset.woff2
.check.woff2

# ── 빌드 산출물 ──
node_modules/
dist/
.cache/

# 로컬 미리보기 설정
.claude/
